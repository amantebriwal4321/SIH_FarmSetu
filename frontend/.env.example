# Copy to frontend/.env.local. Every value is optional.
# With none of them set, the app uses the in-app scorer, the static seed,
# the browser voice, and a Hindi template.
#
# Vercel reserves AWS_REGION, AWS_ACCESS_KEY_ID, and AWS_SECRET_ACCESS_KEY.
# Set the FARMSETU_ names there. Locally, the standard names still work
# when the FARMSETU_ ones are unset. Never commit real keys.

FARMSETU_AWS_REGION=ap-south-1
# FARMSETU_AWS_ACCESS_KEY_ID=
# FARMSETU_AWS_SECRET_ACCESS_KEY=

# Optional local fallbacks. Do not set these on Vercel.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Hindi voice for /api/speak. Kajal is neural hi-IN. Aditi is standard hi-IN.
POLLY_VOICE_ID=Kajal
# POLLY_ENGINE=neural

# CatalogTableName output from `sam deploy`.
# DYNAMODB_TABLE_NAME=

# RiskApiUrl output from `sam deploy`, including /prod/risk.
# NEXT_PUBLIC_RISK_API_URL=

# Optional. Leave unset to keep the local Hindi template.
# Enable the model in the Bedrock console before setting this.
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Optional. Defaults to FARMSETU_AWS_REGION, then AWS_REGION.
# BEDROCK_REGION=ap-south-1
